-- Safe Speed Application
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local holdingEgg = char:FindFirstChild("Egg") or char:FindFirstChild("CarriedEgg")
    IsCarryingEgg = holdingEgg ~= nil

    if AutoSteal then
        if IsCarryingEgg then
            hum.WalkSpeed = ReturnSpeed
        else
            hum.WalkSpeed = StealSpeed
        end
    elseif SpeedEnabled then
        hum.WalkSpeed = CustomSpeed
    end
end)

-- Protected ESP Generator
local function CreateESPContainer(model, titleText, detailsText, color)
    if model:FindFirstChild("MoridiwaaESP") then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "MoridiwaaESP"
    bb.Size = UDim2.fromOffset(180, 50)
    bb.AlwaysOnTop = true
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.Parent = model

    local mainLabel = Instance.new("TextLabel")
    mainLabel.Size = UDim2.new(1, 0, 0, 22)
    mainLabel.BackgroundTransparency = 1
    mainLabel.Text = titleText
    mainLabel.TextColor3 = color or CurrentTheme.Accent
    mainLabel.Font = Enum.Font.GothamBold
    mainLabel.TextSize = 14
    mainLabel.Parent = bb

    local subLabel = Instance.new("TextLabel")
    subLabel.Position = UDim2.fromOffset(0, 22)
    subLabel.Size = UDim2.new(1, 0, 0, 25)
    subLabel.BackgroundTransparency = 1
    subLabel.Text = detailsText
    subLabel.TextColor3 = Color3.fromRGB(230, 230, 235)
    subLabel.Font = Enum.Font.Gotham
    subLabel.TextSize = 11
    subLabel.Parent = bb
end

-- ESP Loop
RunService.RenderStepped:Connect(function()
    if PetESPEnabled or EggESPEnabled then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart) then
                local isEgg = obj.Name:lower():find("egg")
                local isPet = obj.Name:lower():find("pet") or obj:FindFirstChild("PetData")

                if isPet and PetESPEnabled then
                    local weight = obj:GetAttribute("Weight") or "N/A"
                    local price = obj:GetAttribute("Price") or "N/A"
                    local mutation = obj:GetAttribute("Mutation") or "None"
                    local rarity = obj:GetAttribute("Rarity") or "Common"

                    local info = ""
                    if ShowPetWeight then info = info .. "Weight: " .. tostring(weight) .. " | " end
                    if ShowPetPrice then info = info .. "$" .. tostring(price) .. "\n" end
                    if ShowPetMutation then info = info .. "Mut: " .. tostring(mutation) .. " | " end
                    if ShowPetRarity then info = info .. rarity end

                    CreateESPContainer(obj, "🐾 " .. obj.Name, info, Color3.fromRGB(100, 220, 255))
                elseif isEgg and EggESPEnabled then
                    local weight = obj:GetAttribute("Weight") or "N/A"
                    local price = obj:GetAttribute("Price") or "N/A"
                    local rarity = obj:GetAttribute("Rarity") or "Common"

                    local info = ""
                    if ShowEggWeight then info = info .. "Weight: " .. tostring(weight) .. " | " end
                    if ShowEggPrice then info = info .. "$" .. tostring(price) .. "\n" end
                    if ShowEggRarity then info = info .. rarity end

                    CreateESPContainer(obj, "🥚 " .. obj.Name, info, Color3.fromRGB(255, 200, 80))
                end
            end
        end
    end
end)

