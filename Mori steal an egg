-- Anti-Kick & Remote Interceptor
local rawmeta = getrawmetatable(game)
local oldNamecall = rawmeta.__namecall
local oldIndex = rawmeta.__index

setreadonly(rawmeta, false)

rawmeta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- Block Game Kicks
    if method == "Kick" or method == "kick" then
        return nil
    end

    -- Block Detection Remotes
    if method == "FireServer" or method == "InvokeServer" then
        if self and typeof(self) == "Instance" then
            local remoteName = string.lower(self.Name)
            if remoteName:find("ban") or remoteName:find("cheat") or remoteName:find("detect") or remoteName:find("anticheat") or remoteName:find("checkspeed") then
                return nil
            end
        end
    end

    return oldNamecall(self, ...)
end)

-- WalkSpeed Property Spoofing (Game always reads 16)
rawmeta.__index = newcclosure(function(self, idx)
    if not checkcaller() and self and typeof(self) == "Instance" and self:IsA("Humanoid") and idx == "WalkSpeed" then
        return 16
    end
    return oldIndex(self, idx)
end)

setreadonly(rawmeta, true)

