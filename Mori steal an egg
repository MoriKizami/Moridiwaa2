local function ApplyFullTheme(themeName)
    local theme = ThemePresets[themeName]
    if not theme then return end
    _G.MoridiwaaConfig.CurrentTheme = themeName
    
    if Window.SetTheme then
        Window:SetTheme({
            MainColor = theme.Primary,
            AccentColor = theme.Accent,
            BackgroundColor = theme.Secondary,
            FontColor = theme.Text
        })
    end
end

