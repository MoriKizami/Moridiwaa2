-- ESP Engine for Pets and Eggs
local ESPContainer = {}

local function CreateDetailBillboard(parent, textInfo)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(200, 70)
    bb.AlwaysOnTop = true
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Text = textInfo
    label.Parent = bb

    return bb
end

RunService.RenderStepped:Connect(function()
    -- Render Pet ESP
    if _G.MoridiwaaConfig.PetESP then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:FindFirstChild("Weight") or obj:FindFirstChild("Price") or obj:FindFirstChild("Mutation") then
                if not ESPContainer[obj] then
                    local w = obj:FindFirstChild("Weight") and obj.Weight.Value or "N/A"
                    local p = obj:FindFirstChild("Price") and obj.Price.Value or "N/A"
                    local m = obj:FindFirstChild("Mutation") and obj.Mutation.Value or "None"
                    local r = obj:FindFirstChild("Rarity") and obj.Rarity.Value or "Common"
                    
                    local info = string.format("[%s]\nWeight: %s | Price: %s\nMutation: %s | Rarity: %s", obj.Name, tostring(w), tostring(p), tostring(m), tostring(r))
                    ESPContainer[obj] = CreateDetailBillboard(obj, info)
                end
            end
        end
    else
        for k, v in pairs(ESPContainer) do
            if v then v:Destroy() end
            ESPContainer[k] = nil
        end
    end
end)
