-- WalkSpeed Engine
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if _G.MoridiwaaConfig.SpeedEnabled then
            hum.WalkSpeed = _G.MoridiwaaConfig.WalkSpeed
        end
    end
end)

-- Auto Steal Logic (Fast Out / Safe Return)
task.spawn(function()
    while task.wait(0.1) do
        if _G.MoridiwaaConfig.AutoSteal then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if char and hum and hrp then
                local carryingEgg = char:FindFirstChild("Egg") or char:FindFirstChildWithTag("CarryingEgg")
                
                if carryingEgg then
                    -- Safe speed return so egg doesn't reset
                    hum.WalkSpeed = _G.MoridiwaaConfig.ReturnSpeed
                else
                    -- Fast sprint outbound to target
                    if _G.MoridiwaaConfig.SpeedEnabled then
                        hum.WalkSpeed = _G.MoridiwaaConfig.GoSpeed
                    end
                end
            end
        end
    end
end)

-- Auto Treadmill & Upgrades
task.spawn(function()
    while task.wait(0.5) do
        if _G.MoridiwaaConfig.AutoTreadmill then
            local remote = ReplicatedStorage:FindFirstChild("TreadmillRemote", true) or ReplicatedStorage:FindFirstChild("Train", true)
            if remote and remote:IsA("RemoteEvent") then
                remote:FireServer()
            end
        end
        if _G.MoridiwaaConfig.AutoUpgradeTreadmill then
            local upgRemote = ReplicatedStorage:FindFirstChild("UpgradeTreadmill", true)
            if upgRemote and upgRemote:IsA("RemoteEvent") then
                upgRemote:FireServer()
            end
        end
    end
end)

